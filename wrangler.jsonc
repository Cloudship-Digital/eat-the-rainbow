{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eat-the-rainbow",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eat-the-rainbow",
      // No database_id: `wrangler deploy` creates the database the first time and links it.
      // The Worker creates its tables itself on first use (ensureSchema in src/worker.js).
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
